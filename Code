const int pirPin = 6;        
const int tempPin = A0;      
const int motorEnable = 9;   
const int motorIn4 = 4;      
const int motorIn3 = 5;      
const int redLED = 3;
const int greenLED = 2;

bool motionDetected = false;
unsigned long lastMotionTime = 0;
const unsigned long delayTime = 15000; 

void setup() {
  pinMode(pirPin, INPUT);
  pinMode(motorEnable, OUTPUT);
  pinMode(motorIn4, OUTPUT);
  pinMode(motorIn3, OUTPUT);
  pinMode(redLED, OUTPUT);
  pinMode(greenLED, OUTPUT);
  Serial.begin(9600);
}

void loop() {
  motionDetected = digitalRead(pirPin);
  int tempReading = analogRead(tempPin);
  float voltage = tempReading*(5.0/1023.0);
  float temperature = (voltage - 0.5) * 100;
  Serial.print("Temperature: ");
  Serial.println(temperature);

  if (motionDetected == HIGH) {
    lastMotionTime = millis();
    digitalWrite(redLED, LOW);
    digitalWrite(greenLED, HIGH);
    controlFan(temperature);
    
  }
  else {
    if (millis() - lastMotionTime < delayTime) {
      digitalWrite(redLED, LOW);
      digitalWrite(greenLED, HIGH);
      controlFan(temperature);
      
    }
    else {
      digitalWrite(redLED, HIGH);
      digitalWrite(greenLED, LOW);

      stopFan();
    }
  }
}
void controlFan(float temp) {

  digitalWrite(motorIn4, HIGH);
  digitalWrite(motorIn3, LOW);

  if (temp < 10) {
    stopFan();
  }
  else if (temp >= 10 && temp < 25) {
    analogWrite(motorEnable, 85);   
  }
  else if (temp >= 25 && temp < 30) {
    analogWrite(motorEnable, 170);  
  }
  else {
    analogWrite(motorEnable, 255);  
  }
}
void stopFan() {
  analogWrite(motorEnable, 0);
}
